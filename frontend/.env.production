# ==============================================
# NEXT.JS CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=3000

# ==============================================
# API CONFIGURATION
# ⚠️  مهم: بدون /api در انتها — چون api.ts خودش /api/ اضافه می‌کنه
# ==============================================
NEXT_PUBLIC_API_URL=https://raaviiplatform.com
API_URL=http://backend:4000/api

# ==============================================
# SITE CONFIGURATION
# ==============================================
NEXT_PUBLIC_SITE_URL=https://raaviiplatform.com
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_SITE_NAME=Ravi Platform
NEXT_PUBLIC_SITE_DESCRIPTION=پلتفرم راوی

# ==============================================
# AUTHENTICATION
# ==============================================
NEXT_PUBLIC_TOKEN_KEY=ravi_auth_token
NEXT_PUBLIC_SESSION_TIMEOUT=604800000

# ==============================================
# PAYMENT GATEWAY
# ==============================================
NEXT_PUBLIC_ZARINPAL_MERCHANT_ID=
NEXT_PUBLIC_PAYMENT_CALLBACK_URL=https://raaviiplatform.com/payments/verify

# ==============================================
# FEATURE FLAGS
# ==============================================
NEXT_PUBLIC_ENABLE_TELEGRAM=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_WALLET=true
NEXT_PUBLIC_ENABLE_EVENTS=true

# ==============================================
# ANALYTICS (Optional)
# ==============================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ==============================================
# SOCIAL MEDIA (Optional)
# ==============================================
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL=
NEXT_PUBLIC_TWITTER_URL=

# ==============================================
# MAP CONFIGURATION
# ==============================================
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_MAP_CENTER_LAT=35.6892
NEXT_PUBLIC_MAP_CENTER_LNG=51.3890

# ==============================================
# FILE UPLOAD
# ==============================================
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf

# ==============================================
# UI/UX SETTINGS
# ==============================================
NEXT_PUBLIC_DEFAULT_LOCALE=fa
NEXT_PUBLIC_RTL=true
NEXT_PUBLIC_DEFAULT_THEME=light

# ==============================================
# PAGINATION
# ==============================================
NEXT_PUBLIC_ITEMS_PER_PAGE=20
NEXT_PUBLIC_MAX_ITEMS_PER_PAGE=100

# ==============================================
# CACHE SETTINGS
# ==============================================
NEXT_PUBLIC_REVALIDATE_TIME=60

# ==============================================
# ERROR TRACKING (Optional)
# ==============================================
NEXT_PUBLIC_SENTRY_DSN=

# ==============================================
# RECAPTCHA (Optional)
# ==============================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ==============================================
# WEBSOCKET CONFIGURATION
# ==============================================
NEXT_PUBLIC_WS_URL=wss://raaviiplatform.com/ws

# ==============================================
# CDN CONFIGURATION (Optional)
# ==============================================
NEXT_PUBLIC_CDN_URL=

# ==============================================
# TIMEZONE
# ==============================================
TZ=Asia/Tehran
